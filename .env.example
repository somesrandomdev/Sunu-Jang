# Copier en .env puis adapter. Tous les paramètres ont des défauts dans app/config.py.

# URL de l'API Ollama (OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434

# Modèle de chat (voir notes/model_smoke_test.md)
LLM_MODEL=

# Modèle d'embeddings pour le RAG
EMBED_MODEL=nomic-embed-text

# Clé d'API (valeur factice pour Ollama ; utile si vous pointez vers une autre API)
LLM_API_KEY=ollama

# Nombre d'extraits d'annales injectés dans le prompt
TOP_K=3
